ninja_required_version = 1.3
cxx = c++
nvcc = /opt/rocm/core-10.0/bin/hipcc

cflags = -DTORCH_EXTENSION_NAME=e59_pledev_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /opt/venv/lib/python3.14/site-packages/torch/include -isystem /opt/venv/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -isystem /opt/venv/lib/python3.14/site-packages/torch/include/THH -isystem /opt/rocm/core-10.0/include -isystem /usr/include/python3.14 -fPIC -std=c++20
post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC
cuda_cflags = -DWITH_HIP -DTORCH_EXTENSION_NAME=e59_pledev_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /opt/venv/lib/python3.14/site-packages/torch/include -isystem /opt/venv/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -isystem /opt/venv/lib/python3.14/site-packages/torch/include/THH -isystem /opt/rocm/core-10.0/include -isystem /usr/include/python3.14 -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -DHIP_ENABLE_WARP_SYNC_BUILTINS=1 -std=c++20 --offload-arch=gfx1151 -fno-gpu-rdc -O3 --offload-arch=gfx1151
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/opt/venv/lib/python3.14/site-packages/torch/lib -lc10 -lc10_hip -ltorch_cpu -ltorch_hip -ltorch -ltorch_python -L/opt/rocm/core-10.0/lib -lamdhip64

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build e59_ple_dev.cuda.o: cuda_compile @SOURCE@/native-source/ple-device/e59_ple_dev.hip





build e59_pledev_ext.so: link e59_ple_dev.cuda.o

default e59_pledev_ext.so
