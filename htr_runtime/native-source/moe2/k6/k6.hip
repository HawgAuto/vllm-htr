    HTR_PAIRM(16) HTR_PAIRM(18) HTR_PAIRM(20) HTR_PAIRM(22) HTR_PAIRM(24) HTR_PAIRM(26) HTR_PAIRM(28) HTR_PAIRM(30)
#undef HTR_PAIRM
