      case 4: tile_loop_n<4, M, NBL, NT>(qm, (size_t)nt * 32 + a.spadk[4], il, b0, nb, lane, xs_l, bscale, a0, a1); break;
      case 5: tile_loop_n<5, M, NBL, NT>(qm, (size_t)nt * 40 + a.spadk[5], il, b0, nb, lane, xs_l, bscale, a0, a1); break;
