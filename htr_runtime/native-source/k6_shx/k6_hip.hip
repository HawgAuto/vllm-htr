        Vraw[0] = wa.x; Vraw[1] = wa.y; Vraw[2] = wa.z; Vraw[3] = wa.w;
#pragma unroll
        for (int k = 4; k < K; ++k) Vraw[k] = __builtin_nontemporal_load(tp0 + q * K + k);
