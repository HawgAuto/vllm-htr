            d1[r] = __builtin_amdgcn_fdot2(wb, xv[r][((UB) & 7) >> 1], d1[r], false);             \
          }                                                                                       \
        }
        HTR_PAIRM2(0, 18) HTR_PAIRM2(2, 16) HTR_PAIRM2(4, 22) HTR_PAIRM2(6, 20)
#pragma unroll
        for (int r = 0; r < M; ++r) {
