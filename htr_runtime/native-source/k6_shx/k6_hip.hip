#pragma unroll
      for (int r = 0; r < M; ++r) {
        if ((OPT & 1) && r >= mr) continue;
        const float off = off_acc[r] * 1534.0f;
        ep_lds[r][w * 16 + 2 * q]     = a0[r] - off;
        ep_lds[r][w * 16 + 2 * q + 1] = a1[r] - off;
      }
    }
    __syncthreads();
    if (w < mr) {
      const int r = w;
      const k6_f4 s4 = *reinterpret_cast<const k6_f4*>(&ep_lds[r][lane * 4]);
      const k6_h4 hs = *reinterpret_cast<const k6_h4*>(scl + sbl * 128 + lane * 4);
      float v[4] = {k6_nofuse(s4.x * (float)hs.x * a.cb), k6_nofuse(s4.y * (float)hs.y * a.cb), k6_nofuse(s4.z * (float)hs.z * a.cb), k6_nofuse(s4.w * (float)hs.w * a.cb)};
      fwht128_wave(v, lane);
      const unsigned sg4 = (unsigned)svp[sbl * 16 + (lane >> 1)] >> ((lane & 1) * 4);
      k6_f4 o4;
      o4.x = v[0] * (1.0f / 11.313708498984761f); o4.y = v[1] * (1.0f / 11.313708498984761f);
      o4.z = v[2] * (1.0f / 11.313708498984761f); o4.w = v[3] * (1.0f / 11.313708498984761f);
      if (sg4 & 1) o4.x = -o4.x;
      if (sg4 & 2) o4.y = -o4.y;
      if (sg4 & 4) o4.z = -o4.z;
      if (sg4 & 8) o4.w = -o4.w;
      *reinterpret_cast<k6_f4*>(a.out + ((size_t)gidx * M + r) * m + sb * 128 + lane * 4) = o4;
    }
  } else {
  if ((lane >> 3) == 0) {
#pragma unroll
    for (int r = 0; r < M; ++r) {
      if ((OPT & 1) && r >= mr) continue;
      const float off = off_acc[r] * 1534.0f;
      float* pp = a.part + (((size_t)gidx * ns + sp) * M + r) * m + (sb * 8 + w) * 16 + 2 * q;
      pp[0] = a0[r] - off; pp[1] = a1[r] - off;
    }
  }
  if (a.fence_ra) __builtin_amdgcn_fence(__ATOMIC_RELEASE, "agent"); else __threadfence();
  __syncthreads();
  unsigned* cnt = a.counters + (size_t)gidx * MPB + sb;
  if (threadIdx.x == 0) is_last = (atomicAdd(cnt, 1u) == (unsigned)(ns - 1));
  __syncthreads();
  if (!is_last) return;
  if constexpr ((OPT & 16) != 0) { if (threadIdx.x == 0) *cnt = 0u; return; }
  if (a.fence_ra) __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent"); else __threadfence();
  // ---- epilogue (last WG of this expert's strip-block): sum splits, scale*cb, output H128, sv -> f32 out
  if constexpr ((OPT & 64) != 0 && NSC != 0) {
    if (w < mr) {
      const int r = w;
      k6_f4 pv[NSC ? NSC : 1];
#pragma unroll
      for (int k = 0; k < NSC; ++k) pv[k] = __builtin_nontemporal_load(reinterpret_cast<const k6_f4*>(a.part + (((size_t)gidx * NSC + k) * M + r) * m + sb * 128 + lane * 4));
      k6_f4 s4 = {0.f, 0.f, 0.f, 0.f};
#pragma unroll
      for (int k = 0; k < NSC; ++k) s4 += pv[k];
      const k6_h4 hs = *reinterpret_cast<const k6_h4*>(scl + sbl * 128 + lane * 4);
      float v[4] = {k6_nofuse(s4.x * (float)hs.x * a.cb), k6_nofuse(s4.y * (float)hs.y * a.cb), k6_nofuse(s4.z * (float)hs.z * a.cb), k6_nofuse(s4.w * (float)hs.w * a.cb)};
      fwht128_wave(v, lane);
      const unsigned sg4 = (unsigned)svp[sbl * 16 + (lane >> 1)] >> ((lane & 1) * 4);
      k6_f4 o4;
      o4.x = v[0] * (1.0f / 11.313708498984761f); o4.y = v[1] * (1.0f / 11.313708498984761f);
      o4.z = v[2] * (1.0f / 11.313708498984761f); o4.w = v[3] * (1.0f / 11.313708498984761f);
      if (sg4 & 1) o4.x = -o4.x;
      if (sg4 & 2) o4.y = -o4.y;
      if (sg4 & 4) o4.z = -o4.z;
      if (sg4 & 8) o4.w = -o4.w;
      *reinterpret_cast<k6_f4*>(a.out + ((size_t)gidx * M + r) * m + sb * 128 + lane * 4) = o4;
    }
  } else {
    for (int r = 0; r < mr; ++r) {
      if (t < 128) {
        float s = 0.f;
        if constexpr ((OPT & 128) != 0 && NSC != 0) {
          float pv[NSC ? NSC : 1];
#pragma unroll
          for (int k = 0; k < NSC; ++k) pv[k] = __builtin_nontemporal_load(a.part + (((size_t)gidx * NSC + k) * M + r) * m + row);
#pragma unroll
          for (int k = 0; k < NSC; ++k) s += pv[k];
        } else
        for (int k = 0; k < ns; ++k) s += __builtin_nontemporal_load(a.part + (((size_t)gidx * ns + k) * M + r) * m + row);
        ep[t] = s * __half2float(scl[rl]) * a.cb;
      }
      __syncthreads();
      for (int h = 1; h < 128; h <<= 1) {
        float x0 = 0.f, x1 = 0.f;
        if (t < 128) { x0 = ep[t]; x1 = ep[t ^ h]; }
        __syncthreads();
        if (t < 128) ep[t] = (t & h) ? (x1 - x0) : (x0 + x1);
        __syncthreads();
      }
      if (t < 128) {
        float o = ep[t] * (1.0f / 11.313708498984761f);
        if ((svp[rl >> 3] >> (rl & 7)) & 1) o = -o;
        a.out[((size_t)gidx * M + r) * m + row] = o;
      }
      __syncthreads();
    }
  }
  if (t == 0) *cnt = 0u;
  } // end NSC != 1
  if constexpr (FUSE != 0 && PH == 1) {
    // all of this WG's a.out rows for strip-block sb are written; publish, then count groups done for sb
    if (a.fence_ra) __builtin_amdgcn_fence(__ATOMIC_RELEASE, "agent"); else __threadfence();
    __syncthreads();
    if (t == 0) is_last2 = (atomicAdd(a.cnt2 + sb, 1u) == (unsigned)(a.ng[0] - 1));
    __syncthreads();
    if (!is_last2) return;
    if (a.fence_ra) __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent"); else __threadfence();
    if constexpr ((OPT & 32) != 0) {
      if (a.topk != 10) __builtin_trap();
      const int i = sb * 128 + (t & 127);
      for (int tk = t >> 7; tk < a.T; tk += 2) {
        int sl[10]; float wv[10], ov[10];
#pragma unroll
        for (int k = 0; k < 10; ++k) { sl[k] = a.slot[tk * 10 + k]; wv[k] = a.wts[tk * 10 + k]; }
        float so = 0.f, sgv = 0.f;
        if constexpr ((OPT & 4) != 0) { so = a.out[((size_t)A6.sh_g * M + tk) * MOE_H + i]; sgv = A6.sg[tk]; }
#pragma unroll
        for (int k = 0; k < 10; ++k) ov[k] = a.out[(size_t)(sl[k] < 0 ? 0 : sl[k]) * MOE_H + i];
        float s = 0.f;
#pragma unroll
        for (int k = 0; k < 10; ++k) { const float s2 = s + wv[k] * ov[k]; s = sl[k] >= 0 ? s2 : s; }
        if constexpr ((OPT & 4) != 0) s += sgv * so;
        a.y[(size_t)tk * MOE_H + i] = __float2bfloat16(s);
      }
    } else
    if (t < 128) {
      const int i = sb * 128 + t;                 // == k_moe_combine column i (MOE_H = 20 strip-blocks x 128)
      for (int tk = 0; tk < a.T; ++tk) {
        float s = 0.f;
        for (int k = 0; k < a.topk; ++k) {
          const int sl = a.slot[tk * a.topk + k];
          if (sl >= 0) s += a.wts[tk * a.topk + k] * a.out[(size_t)sl * MOE_H + i];
        }
        if constexpr ((OPT & 4) != 0) s += A6.sg[tk] * a.out[((size_t)A6.sh_g * M + tk) * MOE_H + i];
        a.y[(size_t)tk * MOE_H + i] = __float2bfloat16(s);
      }
    }
    if (t == 0) a.cnt2[sb] = 0u;
  }
}

// k6_plan = k_moe_plan2 (identical grp_e/grp_rows/grp_n/slot for groups < A when no expert has more than M rows)
// + SPLIT + the optional shared-expert groups from index A, ng = routed groups + shared groups, and, when nsh > 0,
// sg[t] = sigmoid(wsg . x[t]) (fp32 products, fixed reduction order). One WG of 256. nsh is a host argument so the
// K6-A build (routed only) allocates no shared group and computes no gate.
__global__ void k6_plan(const int* __restrict__ ids, int A, int topk, int M, int* __restrict__ grp_e, int* __restrict__ grp_rows,
                        int* __restrict__ grp_n, int* __restrict__ slot, int* __restrict__ ng, int T, int sh_e, int nsh,
                        const __hip_bfloat16* __restrict__ x, const __hip_bfloat16* __restrict__ wsg, float* __restrict__ sg) {
  __shared__ int s_ng;
  __shared__ float red[256];
  const int a = threadIdx.x;
  if (a == 0) s_ng = 0;
  __syncthreads();
  if (a < A) {
    const int e = ids[a];
    // SPLIT: an expert used by more than M rows becomes several groups of <= M rows (leader = every assignment whose
    // rank among the assignments of the same expert is a multiple of M). Rows are independent, so the launch bucket M
    // no longer has to cover the largest group. For <= M rows per expert this is the old plan, element for element.
    int rank = 0;
    if (e >= 0)
      for (int b = 0; b < a; ++b) rank += ids[b] == e;
    if (e < 0) { grp_e[a] = -1; grp_n[a] = 0; slot[a] = -1; }
    else if (rank % M != 0) { grp_e[a] = -1; grp_n[a] = 0; }
    else {
      int c = 0;
      for (int b = a; b < A && c < M; ++b)
        if (ids[b] == e) { grp_rows[a * M + c] = b / topk; slot[b] = a * M + c; ++c; }
      grp_e[a] = e; grp_n[a] = c;
      for (int c2 = c; c2 < M; ++c2) grp_rows[a * M + c2] = 0;
      atomicAdd(&s_ng, 1);
    }
  }
  __syncthreads();
  if (a == 0) ng[0] = s_ng + nsh;
  if (nsh == 0) return;                           // K6-A: no shared group, no gate
  // shared expert: groups A .. A+nsh-1, rows j*M .. of the T tokens
  if (a < nsh) { grp_e[A + a] = sh_e; grp_n[A + a] = min(M, T - a * M); }
  if (a < nsh * M) grp_rows[A * M + a] = a < T ? a : 0;
  typedef short k6_bf16x2 __attribute__((ext_vector_type(2)));
  for (int t = 0; t < T; ++t) {
    float p = 0.f;
    // MOE_H = 2560 = 640 uint2 (4 bf16/load): 256 threads x 2..3 uint2 loads + native v_dot2_f32_bf16!
    const uint2* wp = reinterpret_cast<const uint2*>(wsg);
    const uint2* xp = reinterpret_cast<const uint2*>(x + (size_t)t * MOE_H);
    for (int i = a; i < (MOE_H / 4); i += 256) {
      const uint2 w4 = wp[i];
      const uint2 x4 = xp[i];
      p = __builtin_amdgcn_fdot2_f32_bf16(__builtin_bit_cast(k6_bf16x2, w4.x), __builtin_bit_cast(k6_bf16x2, x4.x), p, false);
      p = __builtin_amdgcn_fdot2_f32_bf16(__builtin_bit_cast(k6_bf16x2, w4.y), __builtin_bit_cast(k6_bf16x2, x4.y), p, false);
    }
    red[a] = p;
    __syncthreads();
    if (a < 32) {
      float q = 0.f;
      for (int k = 0; k < 8; ++k) q += red[k * 32 + a];
      q = wave_sum(q);
      if (a == 0) sg[t] = 1.0f / (1.0f + __expf(-q));
    }
    __syncthreads();
  }
}
}  // namespace k6a

// hand-written launch/dispatch + entry points (not generated)
#include "k6_host.inc"
