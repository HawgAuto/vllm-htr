// E15-C (2026-10-23) HTR routed-expert PREFILL path for gfx1151 — COMPILE-ONLY until the GPU gates in design/PREFILL-KERNEL-DESIGN.md.
// Identity (wire.py / dq_ref.cu): W = diag(sv) H diag(scale) C H diag(su) / 128 per 128x128 block, C[i,j] = cb[state_ij] =
// cbscale * v(state), v = bytesum((s * 0xDF6ADF + 0x34983) mod 2^32) - 510 in [-510, 510] (exact in f16). So
//   x' = H128(su . x)/sqrt128 (prologue, per token-expert pair)  ->  z = Vint . x' (WMMA f16, f32 acc)  ->
//   y = sv . H128(scale . cbscale . z)/sqrt128 (epilogue, per 128 output rows).
// GEMM core = release direct_moe_wna16_wmma_v13.hip body (BM64 x BN128, BKS32, 8 waves, 3-set register ring, prefetch
// distance 2, double-buffered B in LDS with the sw4 swizzle, v_wmma_f32_16x16x16_f16_w32) with storeB replaced by the HTR
// trellis decoder (K = 4 fixed here) and a Hadamard epilogue. Pairs are in moe_align_block_size SORTED order; A rows are
// pre-transformed and stored contiguously per sorted position (no gather in the hot loop).
#include <torch/extension.h>
#include <ATen/hip/HIPContext.h>
#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <hip/hip_bf16.h>
#include <stdint.h>

typedef _Float16 f16x16 __attribute__((ext_vector_type(16)));
typedef _Float16 h2 __attribute__((ext_vector_type(2)));
typedef float f32x8 __attribute__((ext_vector_type(8)));
typedef uint32_t u32x2 __attribute__((ext_vector_type(2)));
typedef uint32_t u32x4 __attribute__((ext_vector_type(4)));
typedef uint32_t u32x8 __attribute__((ext_vector_type(8)));

#define BM 64
#define BN 128
#define BKS 32
#define RS 20
#define HK 4            // HTR width K (bits per weight) handled by this build
#define NWT (8 * HK)    // words per 16x16 tile
#define GEN_A 0xDF6ADFu
#define GEN_B 0x34983u
#define INV128 (1.0f / 11.313708498984761f)

// ------------------------------------------------------------------ helpers (dq_ref.cu fwht, DPP/permlanex16; v13 swizzle)
template <int MSK> __device__ __forceinline__ float shx(float v) {
  const int iv = __builtin_bit_cast(int, v);
  if constexpr (MSK < 16) {
    return __builtin_bit_cast(float, __builtin_amdgcn_update_dpp(0, iv, 0x160 | MSK, 0xF, 0xF, false));
  } else {
    return __builtin_bit_cast(float, (int)__builtin_amdgcn_permlanex16((unsigned)iv, (unsigned)iv, 0x76543210u, 0xfedcba98u, false, false));
  }
}
template <int MSK> __device__ __forceinline__ void fwht_stage(float v[4], int lane) {
  const bool up = (lane & MSK) != 0;
#pragma unroll
  for (int e = 0; e < 4; ++e) {
    const float o = shx<MSK>(v[e]);
    v[e] = up ? (o - v[e]) : (v[e] + o);
  }
}
// 128-point Walsh-Hadamard over index c = 4*lane + e (one wave32), unnormalised
__device__ __forceinline__ void fwht128_wave(float v[4], int lane) {
  float a = v[0] + v[1], b = v[0] - v[1], c = v[2] + v[3], d = v[2] - v[3];
  v[0] = a + c; v[1] = b + d; v[2] = a - c; v[3] = b - d;
  fwht_stage<1>(v, lane); fwht_stage<2>(v, lane); fwht_stage<4>(v, lane); fwht_stage<8>(v, lane); fwht_stage<16>(v, lane);
}
__device__ __forceinline__ int sw4(int n, int ch) { return n * RS + 4 * (ch ^ ((n >> 4) & 3)); }
__device__ __forceinline__ uint16_t f32_to_bf16_rne(float f) {
  uint32_t u = __float_as_uint(f);
  if ((u & 0x7fffffffu) > 0x7f800000u) return (uint16_t)((u >> 16) | 0x40u);
  u += 0x7fffu + ((u >> 16) & 1u);
  return (uint16_t)(u >> 16);
}
__device__ __forceinline__ _Float16 f16sat(float f, unsigned& sat) {
  if (f > 65504.f) { f = 65504.f; ++sat; } else if (f < -65504.f) { f = -65504.f; ++sat; }
  return (_Float16)f;
}
// trellis value u = v + 510 in [0, 1020] for 16-bit state s (rdna24 generator; bytesum via v_sad_u8)
__device__ __forceinline__ uint32_t tval(uint32_t s) {
  const uint32_t x = s * GEN_A + GEN_B;
  return __builtin_amdgcn_sad_u8(x, 0u, 0u);
}

// ------------------------------------------------------------------ 1/3: activation prologues (one WG = one sorted pair)
// MODE 0 (act_in): src = x bf16 [T, 2560], row = token(p); dst A1 f16 [P, 2560]; su offset 0 (gate/up share su).
// MODE 1 (mid):    src = Y1 bf16 [P, 1280] (gate | up, real space), h = silu(g) * u; dst A2 f16 [P, 640]; su offset 320.
template <int MODE>
__global__ __launch_bounds__(256) void k_hpf_act(const __hip_bfloat16* __restrict__ src, const int32_t* __restrict__ sorted_ids,
                                                 const int32_t* __restrict__ expert_ids, const uint8_t* __restrict__ su, int topk,
                                                 int num_valid, _Float16* __restrict__ dst, unsigned* __restrict__ nsat) {
  constexpr int D = MODE == 0 ? 2560 : 640, SUOFF = MODE == 0 ? 0 : 320, NB = D / 128;
  const int p = blockIdx.x, lane = threadIdx.x & 31, w = threadIdx.x >> 5;
  const int sid = sorted_ids[p], e = expert_ids[p / BM];
  _Float16* out = dst + (size_t)p * D;
  unsigned sat = 0;
  for (int blk = w; blk < NB; blk += 8) {
    const int c0 = blk * 128 + 4 * lane;
    float v[4] = {0.f, 0.f, 0.f, 0.f};
    if (sid < num_valid && e >= 0) {
      const uint8_t* s8 = su + (size_t)e * 400 + SUOFF;
#pragma unroll
      for (int k = 0; k < 4; ++k) {
        const int c = c0 + k;
        float a;
        if constexpr (MODE == 0) {
          a = __bfloat162float(src[(size_t)(sid / topk) * D + c]);
        } else {
          const float g = __bfloat162float(src[(size_t)p * 1280 + c]), u = __bfloat162float(src[(size_t)p * 1280 + 640 + c]);
          a = g / (1.f + __expf(-g)) * u;
        }
        v[k] = ((s8[c >> 3] >> (c & 7)) & 1) ? -a : a;
      }
      fwht128_wave(v, lane);
    }
#pragma unroll
    for (int k = 0; k < 4; ++k) out[c0 + k] = f16sat(v[k] * INV128, sat);
  }
  if (sat) atomicAdd(nsat, sat);
}

// ------------------------------------------------------------------ 2/4: grouped GEMM with trellis B decode + Hadamard epilogue
// PH 0 (up):   N = 1280 (n-block nb < 5: gate role 0 strips nb*8.., else up role 1 strips (nb-5)*8..), K = 2560; out Y1 [P, 1280]
// PH 1 (down): N = 2560 (role 2), K = 640;                                                            out Y2 [P, 2560]
struct GemmArgs {
  const _Float16* A;                       // [P, K] f16, sorted order
  const uint32_t* qw; const int64_t* qoff; // arena words, per-expert role offsets [512, 3]
  const __half* scales; const uint8_t* sv; // arena per-expert scales [512*3840] / sv [512*480]
  const int32_t* sorted_ids; const int32_t* expert_ids; const int32_t* ntpp;
  __hip_bfloat16* Y;                         // [P, N]
  int num_valid, pad; float cb;
};

template <int PH>
__global__ __launch_bounds__(256) __attribute__((amdgpu_waves_per_eu(8, 8))) void k_hpf_gemm(GemmArgs a) {
  constexpr int N = PH == 0 ? 1280 : 2560, K = PH == 0 ? 2560 : 640, NT = K / 16, NS = K / BKS;
  __shared__ __attribute__((aligned(16))) uint32_t Bs[2][BN * RS];
  __shared__ __attribute__((aligned(16))) float Ep[BM][BN + 4];
  __shared__ int32_t s_tok[BM];
  const int tid = threadIdx.x, wave = tid >> 5, lane = tid & 31, l16 = lane & 15;
  const int wm = wave & 3, wn = wave >> 2;
  const int pid_m = blockIdx.y, nb = blockIdx.x;
  if (pid_m * BM >= a.ntpp[0]) return;
  if (tid < BM) s_tok[tid] = a.sorted_ids[pid_m * BM + tid];
  const int e = a.expert_ids[pid_m];
  __syncthreads();
  if (e < 0) return;
  const int role = PH == 0 ? (nb < 5 ? 0 : 1) : 2, sblk = PH == 0 ? (nb < 5 ? nb : nb - 5) : nb;
  const size_t pitch = (size_t)NT * NWT + a.pad;
  const uint32_t* qm = a.qw + a.qoff[(size_t)e * 3 + role] + (size_t)sblk * 8 * pitch;
  const bool wave_active = s_tok[wm * 16] < a.num_valid;
  const _Float16* arow = a.A + (size_t)(pid_m * BM + wm * 16 + l16) * K;
  // B decode mapping (v13 MODE-2 layout): thread -> output row n2 of the 128-row block, k-half h2i (one 16x16 tile column)
  const int n2 = tid & 127, h2i = tid >> 7, r = n2 & 15;
  const uint32_t* strip = qm + (size_t)(n2 >> 4) * pitch;

  u32x4 aX[4], aY[4], aZ[4];
  uint32_t bX[3], bY[3], bZ[3];
  auto loadA = [&](u32x4* dst, int k0) {
    if (wave_active) {
#pragma unroll
      for (int c = 0; c < 4; ++c) dst[c] = *(const u32x4*)(arow + k0 + 8 * c);
    }
  };
  auto loadB = [&](uint32_t* br, int k0) {    // previous word (circular, tail-biting) + the two words of tile row r
    const uint32_t* tile = strip + (size_t)(k0 / 16 + h2i) * NWT;
    br[0] = tile[(2 * r + NWT - 1) % NWT]; br[1] = tile[2 * r]; br[2] = tile[2 * r + 1];
  };
  auto storeB = [&](int buf, const uint32_t* br) {
    // symbol j of row r: state = 16 MSB-first bits ending at bit 32 + 4j + 4 of (br0 : br1 : br2) -> window start 20 + 4j
    // (j = 15 reads only br2: comb >> 32; the 4th word is a zero pad that never reaches the 16 masked bits)
    const uint32_t W[4] = {br[0], br[1], br[2], 0u};
    uint32_t o[8];
#pragma unroll
    for (int jj = 0; jj < 8; ++jj) {
      uint32_t u2[2];
#pragma unroll
      for (int q = 0; q < 2; ++q) {
        const int j = 2 * jj + q, b = 20 + 4 * j, wi = b >> 5, off = b & 31;
        const uint64_t comb = ((uint64_t)W[wi] << 32) | (uint64_t)W[wi + 1];
        const uint32_t s = (uint32_t)(comb >> (48 - off)) & 0xFFFFu;
        u2[q] = tval(s) | 0x6400u;                      // f16 bits of 1024 + u (exact, u < 1024)
      }
      const h2 hv = __builtin_bit_cast(h2, u2[0] | (u2[1] << 16));
      const h2 vv = hv + (h2){(_Float16)-1534.0f, (_Float16)-1534.0f};   // 1024 + u - 1534 = v (exact)
      o[jj] = __builtin_bit_cast(uint32_t, vv);
    }
    uint32_t* bs = Bs[buf];
    *(u32x4*)(&bs[sw4(n2, 2 * h2i)]) = (u32x4){o[0], o[1], o[2], o[3]};
    *(u32x4*)(&bs[sw4(n2, 2 * h2i + 1)]) = (u32x4){o[4], o[5], o[6], o[7]};
  };

  f32x8 acc[4];
#pragma unroll
  for (int j = 0; j < 4; ++j) acc[j] = (f32x8){0, 0, 0, 0, 0, 0, 0, 0};
  auto step = [&](int s, const u32x4* cur, const uint32_t* b1, u32x4* nx, uint32_t* b2) {
    const int buf = s & 1;
    if (s + 2 < NS) { loadA(nx, (s + 2) * BKS); loadB(b2, (s + 2) * BKS); }
    if (wave_active) {
      const uint32_t* bs = Bs[buf];
#pragma unroll
      for (int kc = 0; kc < 2; ++kc) {
        u32x4 x0 = cur[2 * kc], x1 = cur[2 * kc + 1];
        f16x16 af = __builtin_bit_cast(f16x16, (u32x8){x0[0], x0[1], x0[2], x0[3], x1[0], x1[1], x1[2], x1[3]});
#pragma unroll
        for (int j = 0; j < 4; ++j) {
          const int n = 64 * wn + 16 * j + l16;
          u32x4 y0 = *(const u32x4*)(&bs[sw4(n, 2 * kc)]);
          u32x4 y1 = *(const u32x4*)(&bs[sw4(n, 2 * kc + 1)]);
          f16x16 bf = __builtin_bit_cast(f16x16, (u32x8){y0[0], y0[1], y0[2], y0[3], y1[0], y1[1], y1[2], y1[3]});
          acc[j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(af, bf, acc[j]);
        }
      }
    }
    if (s + 1 < NS) storeB(buf ^ 1, b1);
    __syncthreads();
  };
  loadA(aX, 0); loadB(bX, 0);
  if (NS > 1) { loadA(aY, BKS); loadB(bY, BKS); }
  storeB(0, bX);
  __syncthreads();
  for (int s = 0; s < NS; s += 3) {
    step(s, aX, bY, aZ, bZ);
    if (s + 1 < NS) step(s + 1, aY, bZ, aX, bX);
    if (s + 2 < NS) step(s + 2, aZ, bX, aY, bY);
  }
  // ---- epilogue: acc -> LDS, per row: * scale * cbscale, FWHT128 over the 128 outputs, * sv / sqrt128, bf16
  if (wave_active) {
#pragma unroll
    for (int ei = 0; ei < 8; ++ei) {
      const int rr = wm * 16 + 2 * ei + (lane >> 4);
#pragma unroll
      for (int j = 0; j < 4; ++j) Ep[rr][64 * wn + 16 * j + l16] = acc[j][ei];
    }
  }
  __syncthreads();
  const int row0 = nb * 128;                                     // global output row of this block (gate|up contiguous for PH 0)
  const int soff = PH == 0 ? 0 : 1280, svoff = PH == 0 ? 0 : 160;
  const __half* scl = a.scales + (size_t)e * 3840 + soff + row0;
  const uint8_t* svp = a.sv + (size_t)e * 480 + svoff;
  for (int rr = wave; rr < BM; rr += 8) {
    if (s_tok[rr] >= a.num_valid) continue;                       // wave-uniform
    float v[4];
#pragma unroll
    for (int k = 0; k < 4; ++k) v[k] = Ep[rr][4 * lane + k] * __half2float(scl[4 * lane + k]) * a.cb;
    fwht128_wave(v, lane);
    uint16_t o[4];
#pragma unroll
    for (int k = 0; k < 4; ++k) {
      const int gr = row0 + 4 * lane + k;
      float y = v[k] * INV128;
      if ((svp[gr >> 3] >> (gr & 7)) & 1) y = -y;
      o[k] = f32_to_bf16_rne(y);
    }
    *(uint2*)(a.Y + (size_t)(pid_m * BM + rr) * N + row0 + 4 * lane) =
        make_uint2((uint32_t)o[0] | ((uint32_t)o[1] << 16), (uint32_t)o[2] | ((uint32_t)o[3] << 16));
  }
}

// ------------------------------------------------------------------ 5: deterministic weighted reduce (fixed slot order)
// inv[t*topk + s] = sorted position of assignment (t, s); out[t] = sum_s w[t, s] * Y2[inv[t*topk+s]]
__global__ void k_hpf_inv(const int32_t* __restrict__ sorted_ids, const int32_t* __restrict__ ntpp, int num_valid,
                          int32_t* __restrict__ inv) {
  const int p = blockIdx.x * 256 + threadIdx.x;
  if (p >= ntpp[0]) return;
  const int s = sorted_ids[p];
  if (s < num_valid) inv[s] = p;
}
__global__ __launch_bounds__(256) void k_hpf_reduce(const __hip_bfloat16* __restrict__ Y2, const int32_t* __restrict__ inv,
                                                    const float* __restrict__ w, int topk, __hip_bfloat16* __restrict__ out) {
  const int t = blockIdx.x;
  for (int i = threadIdx.x; i < 2560; i += 256) {
    float acc = 0.f;
    for (int s = 0; s < topk; ++s) {
      const float ws = w[t * topk + s];
      if (ws != 0.f) acc += ws * __bfloat162float(Y2[(size_t)inv[t * topk + s] * 2560 + i]);
    }
    out[(size_t)t * 2560 + i] = __float2bfloat16(acc);
  }
}

// ================================================================== host
static void launch_act0(int P, hipStream_t st, const __hip_bfloat16* x, const int32_t* sid, const int32_t* eid, const uint8_t* su,
                        int topk, int nv, _Float16* A1, unsigned* nsat) {
 hipLaunchKernelGGL(( k_hpf_act<0>), dim3(P), dim3(256), 0, st, x, sid, eid, su, topk, nv, A1, nsat);
}
static void launch_act1(int P, hipStream_t st, const __hip_bfloat16* y1, const int32_t* sid, const int32_t* eid, const uint8_t* su,
                        int topk, int nv, _Float16* A2, unsigned* nsat) {
 hipLaunchKernelGGL(( k_hpf_act<1>), dim3(P), dim3(256), 0, st, y1, sid, eid, su, topk, nv, A2, nsat);
}
static void launch_gemm0(dim3 g, hipStream_t st, GemmArgs a) {hipLaunchKernelGGL(( k_hpf_gemm<0>), dim3(g), dim3(256), 0, st, a); }
static void launch_gemm1(dim3 g, hipStream_t st, GemmArgs a) {hipLaunchKernelGGL(( k_hpf_gemm<1>), dim3(g), dim3(256), 0, st, a); }

// x bf16 [T, 2560]; sorted_ids/expert_ids/ntpp from moe_align_block_size(ids, BM=64, 512) on (ids clamped >= 0);
// w f32 [T, topk] (0 for padded slots). Scratch A1 [Pmax, 2560] f16, Y1 [Pmax, 1280] bf16, A2 [Pmax, 640] f16, Y2 [Pmax, 2560] bf16,
// inv [T*topk] i32, nsat [1] u32 (accumulates). Returns out bf16 [T, 2560].
torch::Tensor hpf_forward(torch::Tensor x, torch::Tensor sorted_ids, torch::Tensor expert_ids, torch::Tensor ntpp, torch::Tensor w,
                          torch::Tensor qw, torch::Tensor qoff, torch::Tensor scales, torch::Tensor su, torch::Tensor sv, double cb,
                          int64_t K, int64_t pad, torch::Tensor A1, torch::Tensor Y1, torch::Tensor A2, torch::Tensor Y2,
                          torch::Tensor inv, torch::Tensor nsat) {
  TORCH_CHECK(K == HK, "this build decodes K = 4 only");
  TORCH_CHECK(x.is_cuda() && x.is_contiguous() && x.scalar_type() == torch::kBFloat16 && x.dim() == 2 && x.size(1) == 2560);
  TORCH_CHECK(w.is_contiguous() && w.scalar_type() == torch::kFloat32 && w.dim() == 2 && w.size(0) == x.size(0));
  TORCH_CHECK(sorted_ids.scalar_type() == torch::kInt32 && expert_ids.scalar_type() == torch::kInt32 && ntpp.scalar_type() == torch::kInt32);
  const int T = x.size(0), topk = w.size(1), nv = T * topk, P = sorted_ids.numel();
  TORCH_CHECK(P % BM == 0 && expert_ids.numel() == P / BM && A1.numel() >= (int64_t)P * 2560 && Y1.numel() >= (int64_t)P * 1280 &&
              A2.numel() >= (int64_t)P * 640 && Y2.numel() >= (int64_t)P * 2560 && inv.numel() >= nv, "scratch too small");
  TORCH_CHECK(qw.scalar_type() == torch::kInt32 && qoff.scalar_type() == torch::kInt64 && scales.scalar_type() == torch::kHalf &&
              su.scalar_type() == torch::kUInt8 && sv.scalar_type() == torch::kUInt8);
  auto st = at::cuda::getCurrentCUDAStream();
  const int32_t* sid = sorted_ids.data_ptr<int32_t>(); const int32_t* eid = expert_ids.data_ptr<int32_t>();
  unsigned* ns = reinterpret_cast<unsigned*>(nsat.data_ptr<int32_t>());
  launch_act0(P, st, reinterpret_cast<const __hip_bfloat16*>(x.data_ptr<at::BFloat16>()), sid, eid, su.data_ptr<uint8_t>(), topk, nv,
              reinterpret_cast<_Float16*>(A1.data_ptr<at::Half>()), ns);
  GemmArgs a;
  a.qw = reinterpret_cast<const uint32_t*>(qw.data_ptr<int32_t>()); a.qoff = qoff.data_ptr<int64_t>();
  a.scales = reinterpret_cast<const __half*>(scales.data_ptr<at::Half>()); a.sv = sv.data_ptr<uint8_t>();
  a.sorted_ids = sid; a.expert_ids = eid; a.ntpp = ntpp.data_ptr<int32_t>(); a.num_valid = nv; a.pad = (int)pad; a.cb = (float)cb;
  a.A = reinterpret_cast<const _Float16*>(A1.data_ptr<at::Half>()); a.Y = reinterpret_cast<__hip_bfloat16*>(Y1.data_ptr<at::BFloat16>());
  launch_gemm0(dim3(1280 / BN, P / BM), st, a);
  launch_act1(P, st, reinterpret_cast<const __hip_bfloat16*>(Y1.data_ptr<at::BFloat16>()), sid, eid, su.data_ptr<uint8_t>(), topk, nv,
              reinterpret_cast<_Float16*>(A2.data_ptr<at::Half>()), ns);
  a.A = reinterpret_cast<const _Float16*>(A2.data_ptr<at::Half>()); a.Y = reinterpret_cast<__hip_bfloat16*>(Y2.data_ptr<at::BFloat16>());
  launch_gemm1(dim3(2560 / BN, P / BM), st, a);
 hipLaunchKernelGGL(( k_hpf_inv), dim3((P + 255) / 256), dim3(256), 0, st, sid, a.ntpp, nv, inv.data_ptr<int32_t>());
  auto out = torch::empty({T, 2560}, x.options());
 hipLaunchKernelGGL(( k_hpf_reduce), dim3(T), dim3(256), 0, st, reinterpret_cast<const __hip_bfloat16*>(Y2.data_ptr<at::BFloat16>()), inv.data_ptr<int32_t>(),
                                  w.data_ptr<float>(), topk, reinterpret_cast<__hip_bfloat16*>(out.data_ptr<at::BFloat16>()));
  return out;
}
