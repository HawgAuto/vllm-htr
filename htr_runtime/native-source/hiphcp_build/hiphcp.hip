template <int MW, int RF, int LY>
__global__ void __launch_bounds__(64 * MW) hc_ugmqq(const __bf16* __restrict__ lora, const uint8_t* __restrict__ uq,
                                                     const uint32_t* __restrict__ usz, int NG,
