    const int s = t / KC, k0 = (t - s * KC) * 32;
#pragma unroll
    for (int i = 0; i < NB; ++i) {
      const int c = tid + T * i;
      if (c < BCH) {
        const long long row = (long long)(s * H + n0 + (c >> 1));
