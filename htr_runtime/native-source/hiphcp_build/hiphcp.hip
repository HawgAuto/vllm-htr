        if ((k0 & 127) == 0) {
          const uint32_t z = usz[row * NG + (k0 >> 7)];
          const float sc = h2f(z & 0xFFFFu);
          bs[i] = sc;
          bnzs[i] = -(float)((z >> 16) & 255u) * sc;
        }
      }
    }
  };
  auto sstoreB = [&](int buf) {
#pragma unroll
    for (int i = 0; i < NB; ++i) {
      const int c = tid + T * i;
