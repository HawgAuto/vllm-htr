      org.opencontainers.image.source="https://github.com/HawgAuto/vllm-htr" \
      org.opencontainers.image.description="vllm-htr v0.2.8 — ERNIE-5.5-Flash-HTR 2.1x roofline prefill (686 Wave32 kernels), FlashIndexer H=8, DSpark filtered drafting & ernie55/ernie5 parsers (Qwen3.8 v0.2.7 intact)"
